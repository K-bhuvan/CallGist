# --- LLM Provider (pick one) ---

# Option A: OpenAI
OPENAI_API_KEY=sk-your-key-here

# Option B: OpenRouter (set LLM_PROVIDER=openrouter, uses gpt-4o-mini by default)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_REFERRER=https://callgist.app

# Option C: Any OpenAI-compatible API (set LLM_BASE_URL + appropriate key)
# LLM_BASE_URL=https://your-custom-api.com/v1
# LLM_PROVIDER=custom

# Model override (default: gpt-4o-mini)
# LLM_MODEL=anthropic/claude-3.5-sonnet

# --- Email delivery (SendGrid) ---
SENDGRID_API_KEY=SG.your-key-here
SENDGRID_FROM_EMAIL=reports@callgist.app
SENDGRID_FROM_NAME=CallGist
REPORT_TO_EMAIL=owner@example.com

# --- Database (SQLite default is data/db/callgist.db) ---
# DATABASE_URL=sqlite:///data/db/callgist.db

# --- Logging (set to "json" for structured JSON output) ---
# LOG_FORMAT=console